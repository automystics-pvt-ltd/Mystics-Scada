auto-install-peers=false
strict-peer-dependencies=false

# Allow native build scripts for these packages (pnpm v10+ reads .npmrc, not package.json pnpm field)
onlyBuiltDependencies[]=@serialport/bindings-cpp
onlyBuiltDependencies[]=better-sqlite3
onlyBuiltDependencies[]=cpu-features
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=ssh2
